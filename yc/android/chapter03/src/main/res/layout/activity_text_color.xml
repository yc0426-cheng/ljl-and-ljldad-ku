<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView
        android:id="@+id/tv_color_style"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_hello"
        android:textSize="30sp" />


    <TextView
        android:id="@+id/tv_color_eight"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_color"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tv_color_xml"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_color_xml"
        android:textColor="#00ff00"
        android:textSize="30sp" />

    <TextView
        android:id="@+id/tv_color_blue_xml"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/tv_color_xml"
        android:textColor="@color/blue"
        android:textSize="30sp" />

</LinearLayout>
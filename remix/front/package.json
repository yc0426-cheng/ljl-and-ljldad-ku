{
  "name": "remix-front",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "type-check": "vue-tsc --noEmit",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.7.7",
    "element-plus": "^2.14.5",
    "pinia": "^2.2.4",
    "vue": "^3.5.12",
    "vue-router": "^4.4.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@types/node": "^22.7.4",
    "@vitejs/plugin-vue": "^5.1.4",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-vue": "^9.32.0",
    "globals": "^15.13.0",
    "jiti": "^2.4.0",
    "npm-run-all2": "^7.0.1",
    "oxlint": "^0.15.0",
    "prettier": "^3.4.2",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.20.0",
    "vite": "^5.4.9",
    "vue-tsc": "^2.1.6"
  }
}

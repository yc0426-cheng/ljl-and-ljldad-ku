# ===== 必填配置 =====
# 通义千问 API 密钥（从阿里云百炼控制台获取）
DASHSCOPE_API_KEY=你的通义千问密钥

# 服务访问密钥（调用接口时需带 X-API-Key 请求头）
# 留空 = 所有接口不鉴权（仅建议本地调试时留空）
API_KEY=你的服务访问密钥

# ===== 可选配置（不写则用默认值）=====
# 数据目录（多用户下每个用户独立子目录 <DATA_DIR>/<user_id>/）
# DATA_DIR=./app/data
# CHROMA_PATH=./app/chroma_db
# COLLECTION_NAME=my_md_knowledge
# EMBED_MODEL_NAME=BAAI/bge-small-zh-v1.5
# LLM_MODEL_NAME=qwen-plus
# LLM_TEMPERATURE=0.3
# CHUNK_SIZE=512
# CHUNK_OVERLAP=50
# TOP_K=5
# 相似度阈值：低于该值的片段不采纳，0 表示不启用（建议从 0.3 试起，太高会误伤）
# MIN_SCORE=0.3
# 命令行模式默认使用的用户ID
# DEFAULT_USER_ID=1
